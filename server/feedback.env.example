# Create a dedicated public repository for website feedback before enabling this service.
FEEDBACK_GITHUB_OWNER=your-github-account
FEEDBACK_GITHUB_REPO=periodic-table-feedback
FEEDBACK_GITHUB_TOKEN=

# Comma-separated, exact browser origins. Do not add paths or trailing slashes.
FEEDBACK_ALLOWED_ORIGINS=https://periodic-table.example

# Keep this directory outside the public website document root.
FEEDBACK_DATA_DIR=/var/lib/periodic-table-feedback

# The receiver defaults to 127.0.0.1:4186. Keep loopback binding behind a reverse proxy.
# FEEDBACK_HOST=127.0.0.1
# FEEDBACK_PORT=4186
# Only set this when the listed proxy overwrites X-Forwarded-For with one client IP.
# FEEDBACK_TRUSTED_PROXY_ADDRESSES=127.0.0.1
